# Copy to .env (gitignored) and fill in.
# On Windows: JANGAN pakai `Set-Content -Encoding utf8` (bikin BOM + mojibake).
# Edit manual atau append UTF-8 tanpa BOM.

# === Enkripsi ===============================================================
# Kunci Fernet untuk enkripsi password koneksi MS SQL. Generate:
#   python manage.py generate_key
POS_FERNET_KEY=

# === Koneksi grosir dev (di-seed oleh `python manage.py seed_dev`) ==========
POS_DB_GROSIR_HOST=localhost
POS_DB_GROSIR_PORT=1433
POS_DB_GROSIR_NAME=database
POS_DB_GROSIR_USER=sa
POS_DB_GROSIR_PASSWORD=

# === Django core ============================================================
# 1 = dev (Vite HMR, error verbose). 0 = produksi. Default: 1.
DEBUG=1
# WAJIB di-set di produksi (DEBUG=0). Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
# Host/domain yang boleh mengakses. Comma-separated. Prefix "." = wildcard subdomain.
# Contoh: LAN + Tailscale → 127.0.0.1,localhost,192.168.1.10,namamesin.namatailnet.ts.net
ALLOWED_HOSTS=127.0.0.1,localhost
# Idle session (detik). Default 14400 (4 jam).
SESSION_IDLE_SECONDS=14400
# Zona waktu tampilan (jam di Log Aktivitas, Riwayat Sinkronisasi, dsb).
# Penyimpanan tetap UTC. Nama zona IANA: Asia/Jakarta (WIB), Asia/Makassar
# (WITA), Asia/Jayapura (WIT).
TIME_ZONE=Asia/Jakarta

# === Akses jaringan (/admin-panel/*) =======================================
# 1 = batasi admin panel ke range Tailscale saja. Default: ikut (not DEBUG).
ENFORCE_TAILSCALE=0
# Range CGNAT Tailscale. Ubah hanya bila tailnet custom. Default 100.64.0.0/10.
TAILSCALE_CIDR=100.64.0.0/10

# === Vite / static ==========================================================
# 1 = mode HMR (butuh `npm run dev`, akses localhost saja).
# 0 = serve hasil `npm run build` dari Django (bisa lintas device/Tailscale).
# Kosong = ikut DEBUG.
DJANGO_VITE_DEV=0

# === Database indexes =======================================================
# Auto-index MSSQL saat profil aktif/terdaftar (1=aktif, 0=manual via manage.py ensure_indexes)
POS_AUTO_INDEX=1

# === Cache master data ======================================================
# Umur cache tabel m_* (detik) untuk pengisian MALAS (saat halaman dibuka dan
# cache kosong). Membaca 55rb barang terukur 1,2 detik lewat LAN tapi 21,8 detik
# lewat Tailscale antar-kota. Perubahan master tetap langsung terlihat karena
# setiap penulisan memanggil invalidate_master_cache().
# Di produksi naikkan ke 3600 — master data jarang berubah, dan tiap pengisian
# ulang cache lewat Tailscale memakan 21,8 detik.
POS_MASTER_TTL=600

# Pemanas cache: scheduler mengisi ulang cache master tiap tick di latar, dengan
# umur 3x jeda tick, sehingga entri selalu diganti SEBELUM kedaluwarsa. Tanpa ini
# ongkos cache dingin (~30 detik di profil WAN) selalu ditanggung pengguna
# pertama setelah TTL habis atau setelah server restart. 0 = matikan (halaman
# kembali mengisi cache secara malas dan sesekali lambat).
MASTER_WARM_ENABLED=1

# === Batas waktu query MS SQL (detik) =======================================
# POS_QUERY_TIMEOUT: halaman interaktif. POS_SNAPSHOT_TIMEOUT: pembangun
# snapshot stok, query terberat di aplikasi dan jalan di latar. Kalau pembangun
# base kena timeout, scheduler gagal tanpa mencatat marker dan mengulang tiap
# 30 menit — server itu tak pernah punya snapshot, artinya jalur lambat
# permanen. Naikkan untuk server jauh/lambat.
POS_QUERY_TIMEOUT=60
POS_SNAPSHOT_TIMEOUT=900

# === Snapshot harga harian (scheduler in-process) ===========================
# Deteksi perubahan harga per hari untuk koneksi aktif, jalan sendiri selama
# server hidup (tanpa Task Scheduler). 0 = matikan (pakai `manage.py snapshot_harga` manual).
HARGA_SNAPSHOT_ENABLED=1
# Jam lokal minimum sebelum boleh jalan (0 = kesempatan pertama tiap hari saat server hidup).
HARGA_SNAPSHOT_HOUR=0
# Jeda cek antar-iterasi (detik). Default 1800 = 30 menit. Dipakai bersama snapshot stok.
HARGA_SNAPSHOT_INTERVAL_SECONDS=1800

# === Snapshot stok (scheduler in-process, SEMUA profil) =====================
# Dua lapis: base beku (~13 bln lalu, rebuild bulanan) + live (base + delta,
# rebuild harian). Halaman Stok Akhir dkk baca live + delta kecil → detik-an.
# Jalan untuk SEMUA server, berurutan, per-profil terisolasi.
# 0 = matikan (pakai `manage.py snapshot_stok` manual / Task Scheduler).
STOK_SNAPSHOT_ENABLED=1
# Jam lokal minimum sebelum boleh jalan. Default 0 = kesempatan pertama tiap hari
# SAAT SERVER HIDUP (server toko cuma nyala jam kerja, bukan dini hari). Tick
# scheduler tiap 30 mnt retry sampai sukses hari itu.
STOK_SNAPSHOT_HOUR=0
# Batas region immutable (bulan). Rebuild live cukup scan window ini, bukan
# seluruh histori sejak tutup buku. Default 13 (admin diasumsikan tak edit data
# lebih lama dari ini).
STOK_SNAPSHOT_BASE_MONTHS=13
# Umur maksimum snapshot live (hari) sebelum dianggap basi → jalur baca fallback
# ke re-agregasi penuh. Default 7.
STOK_SNAPSHOT_MAX_AGE_DAYS=7

# === Kesehatan sync (halaman superadmin "Kesehatan Sync") ===================
# Tiap tick scheduler, catat satu sampel per server: kedalaman antrean keluar
# (tbl_tmp_post), umur baris tertuanya, dan umur watermark tarik (tbl_waktu_get).
# Semua kuerinya seek/metadata, bukan scan — 13 server selesai ~8 detik.
# Halaman membaca angka langsung saat dibuka; yang dicatat di sini RIWAYATnya,
# supaya "antre 8.000" bisa dibedakan dari "antre 8.000 dan naik terus sejak Mei".
# 0 = matikan pencatatan riwayat (halaman tetap bisa dibuka).
SYNC_HEALTH_ENABLED=1

# === Fan-out master data gudang -> toko (apps/transactions/feed_sync.py) ====
# Jalur sync milik sendiri: baca feed tbl_log_transaksi di sumber, terapkan ke
# toko lewat pyodbc berparameter. Tanpa xp_cmdshell/curl/web legacy, dan tanpa
# pernah menjalankan SQL kiriman. Berjalan BERDAMPINGAN dengan job SQL Agent
# lama — tidak ada job legacy yang dimatikan olehnya.
#
# DEFAULT MATI, dan biarkan begitu sampai dry-run diperiksa:
#   python manage.py sync_feed --source GUDANG --dry-run
# Menyalakannya memindahkan data antar-server produksi. Menulis ke toko BISA
# menyalakan trigger legacy toko itu (antreannya ikut naik), tapi itu tergantung
# cabang: testgudang naik 4 -> 1.244, RUMAK tetap 0 karena m_barang di sana tak
# bertrigger. Bukan kerusakan, cuma pemborosan; terlihat di Kesehatan Sync.
FEED_SYNC_ENABLED=0
# Nama ServerProfile sumber. Default GUDANG.
FEED_SYNC_SOURCE=GUDANG
# CSV nama profil tujuan. JANGAN dikosongkan di produksi: kosong berarti "semua
# profil kecuali sumber", yang ikut menyertakan server retail (di luar lingkup).
FEED_SYNC_TARGETS=ANDARIA,DRAGON,KOTA MAS,PAGESANGAN,PRAYA,PUSAT,RUMAK,TANJUNG
# Baris feed per tujuan per tick. Default 2000.
FEED_SYNC_LIMIT=2000

# === Pusat data AMPHOREUS (apps/transactions/hub_sync.py) ==================
# Menarik data 9 cabang (gudang + 8 grosir) ke satu database pusat milik sendiri
# di SERVER-RETAIL/AMPHOREUS. Tanpa web legacy, tanpa xp_cmdshell, tanpa escape
# buatan tangan, tanpa pernah menjalankan SQL kiriman. Berjalan BERDAMPINGAN
# dengan job SQL Agent lama.
#
# Prasyarat, dua-duanya wajib:
#   1. ServerProfile bernama AMPHOREUS menunjuk ke database pusat.
#   2. `kode_sumber` terisi di tiap cabang. Cabang tanpa kode DILEWATI, bukan
#      ditebak dari nama — tidak ada satu pun kolom di data legacy yang menandai
#      server asal, dan no_transaksi bisa sama antar-cabang.
# Lalu: python manage.py init_hub --hub AMPHOREUS --ref GUDANG
#
# DEFAULT MATI. Periksa dulu:
#   python manage.py sync_hub --hub AMPHOREUS --dry-run
HUB_SYNC_ENABLED=0
# Nama ServerProfile pusat. Default AMPHOREUS.
HUB_NAME=AMPHOREUS
# Baris feed per cabang per tick. Default 2000.
HUB_SYNC_LIMIT=2000

# --- Pusat AMPHOREUS: tarik langsung (hub_pull) -----------------------------
#
# PENGGANTI HUB_SYNC. Membaca tabel transaksi ASLI tiap cabang, bukan
# `tbl_log_transaksi`. Jangan menyalakan HUB_SYNC_ENABLED dan HUB_PULL_ENABLED
# bersamaan: keduanya menulis tabel pusat yang sama dan yang belakangan menang.
#
# Kenapa diganti (semuanya terukur, bukan dugaan):
#   - cursor feed ANDARIA tertinggal 1,7 juta baris = 18-100 hari untuk mengejar
#   - feed BISA dipangkas: PUSAT kehilangan 1.471.184 id, PRAYA dipotong dari
#     depan sampai id 2.658.002 — yang lenyap tak bisa dipulihkan dari feed
#   - nilai dari feed TERPOTONG trigger legacy (m_barang PRAYA mentok 30 karakter)
#
# Tiga tingkat, disekat `g_tutup_buku`:
#   arsip  <= tutup buku   : SEKALI, manual   -> pull_hub --mode arsip
#   cocok  tutup buku..H-N : sekali sehari    -> HUB_MATCH_ENABLED
#   segar  N hari terakhir : tiap tick        -> HUB_PULL_ENABLED
#
# DEFAULT MATI. Periksa dulu:
#   python manage.py pull_hub --mode segar --dry-run
HUB_PULL_ENABLED=0
# Panjang jendela segar (hari). Default 7.
HUB_PULL_DAYS=7
# Pencocokan harian tutup buku..H-N. Satu kueri beragregat per tabel per cabang
# (terukur 0,13-0,15 dtk untuk 900-2.000 hari), bukan satu kueri per hari.
HUB_MATCH_ENABLED=0
# Jam lokal minimum sebelum pencocokan harian boleh jalan. Default 2.
HUB_MATCH_HOUR=2
# Master data AMPHOREUS mengikuti GUDANG saja (ikut slot harian pencocokan).
# Bersihkan sisa master cabang lain sekali dengan:
#   python manage.py pull_master --purge-lain --dry-run
HUB_MASTER_ENABLED=0

# --- Sebar harga GUDANG -> toko grosir (harga_sync) ------------------------
#
# Harga grosir harus berubah hampir seketika di semua toko. `feed_sync` sudah
# menyebarkan m_barang_satuan, tapi jadwalnya 30 menit DAN ia hanya melihat apa
# yang ditulis trigger legacy — perubahan lewat SQL langsung tak pernah lewat.
#
# Modul ini tidak membaca feed sama sekali; ia membandingkan harga apa adanya.
# Terukur: baca penuh m_barang_satuan GUDANG = 55.365 baris / 1,90 dtk (ANDARIA
# lewat Tailscale 1,78 dtk), sementara perubahan nyata cuma 1-125 harga per hari.
#
# Dua lapis:
#   - thread 60 detik  -> menyapu perubahan dari mana pun asalnya
#   - dorongan seketika -> saat harga diubah lewat Arunika, tanpa menunggu sapuan
#
# DEFAULT MATI, dan ini satu-satunya jalur baru yang MENULIS KE SERVER TOKO
# (tiap tulisan menyalakan trigger legacy di sana). Periksa dulu:
#   python manage.py sync_harga --dry-run
HARGA_SYNC_ENABLED=0
# Jeda sapuan cepat. Minimum efektif 15 detik.
HARGA_SYNC_INTERVAL_SECONDS=60
# Berapa menit sekali sapuan PENUH (membaca keadaan nyata tiap toko, ~1,8 dtk
# per toko). Sapuan pertama sesudah restart selalu penuh. Hanya sapuan penuh
# yang menambal harga yang gagal terkirim saat sebuah toko sedang mati, jadi
# jangan dibuat terlalu jarang.
HARGA_SYNC_FULL_MINUTES=60

# --- Master non-harga GUDANG -> toko grosir --------------------------------
#
# Nama barang, merek, supplier. `feed_sync` sudah menyebarkannya, TAPI lewat
# `tbl_log_transaksi` — jalur memo yang sama yang ditinggalkan untuk arah
# cabang -> AMPHOREUS, dengan cacat yang sama: memo bisa dipangkas, dan trigger
# legacy memotong isinya. Bedanya, di sini tak ada yang membandingkan, jadi nama
# barang yang gagal menyeberang TIDAK AKAN PERNAH ketahuan.
#
# Modul ini membaca kedua sisi lalu menulis yang beda. Sekali sehari, ikut slot
# harian pencocokan. Harga tidak ikut (milik HARGA_SYNC, tiap 60 detik).
#
# TIDAK PERNAH MENGHAPUS di toko: barang lokal toko yang tak ada di gudang
# dibiarkan, dan jumlahnya dilaporkan sebagai `dilewati`. Menghapusnya berarti
# membuang data milik toko, dan nota-nota lamanya masih menunjuk ke sana.
#
# DEFAULT MATI. Periksa volumenya dulu:
#   python manage.py sync_master --dry-run
MASTER_TOKO_ENABLED=0

# === Laporan: batas & fleksibilitas akses data ==============================
# Tabel di layar tetap paginated (ringan). Export = XLSX STREAMING (cursor ->
# openpyxl write_only, memori app datar walau ratusan ribu baris) + rentang
# tanggal dilepas. Peringan DB berat = set report_source (replica) pada profil
# koneksi. Semua batas opsional (punya default), bisa ditune tanpa ubah kode.
# Plafon page-size tabel layar (opsi UI s.d. 1000). Default 1000.
REPORT_MAX_PER_PAGE=1000
# Clamp rentang tanggal jalur INTERAKTIF (hari); jalur export TIDAK di-clamp. Default 92.
# Halaman Klasifikasi Pelanggan MELEPAS clamp ini (lihat max_range_days pada
# spec-nya): dgn jendela 92 hari, "belum belanja lebih dari setahun" tak mungkin
# terlihat. Halaman lain tetap ikut angka di bawah.
REPORT_MAX_RANGE_DAYS=92
# Batas baris export XLSX (jaga limit Excel ~1jt baris). Default 100000.
REPORT_EXPORT_CAP=100000

# === Klasifikasi Pelanggan: penampung transaksi yang dikecualikan ============
# Kode pelanggan yang BUKAN orang, melainkan penampung transaksi tanpa identitas
# (UMUM/ECERAN/OBRAL). Dikecualikan dari daftar follow-up — tak ada yang bisa
# dihubungi, dan ECERAN sendiri memegang 99,3% nota di server retail.
# Diverifikasi ada di kelima profil koneksi. Default: CAA000,CAA025,CAA027.
# Set ke kosong (POS_PSEUDO_CUSTOMERS=) untuk menampilkan semuanya.
#POS_PSEUDO_CUSTOMERS=CAA000,CAA025,CAA027
# Pola NAMA yang juga dikecualikan (kanal jualan, bukan orang). Dicocokkan
# sebagai potongan nama, tak peka huruf besar-kecil, jadi marketplace baru cukup
# ditambah di sini tanpa mencari kodenya.
# Default: SHOPEE,TOKOPEDIA,TIKTOK,LAZADA,BLIBLI,BUKALAPAK
#POS_PSEUDO_CUSTOMER_NAMES=SHOPEE,TOKOPEDIA,TIKTOK
